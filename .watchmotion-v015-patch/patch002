+    /** Best-effort only. New Android builds may deny /proc/net/arp access. */
+    private fun lookupNeighborMac(host: String): String {
+        if (host.isBlank()) return ""
+        try {
+            val arp = File("/proc/net/arp")
+            if (!arp.canRead()) return ""
+            FileReader(arp).useLines { lines ->
+                lines.drop(1).forEach { line ->
+                    val cols = line.trim().split(Regex("\\s+"))
+                    if (cols.size >= 4 && cols[0] == host) {
+                        return LgTvController.normalizeMac(cols[3]).orEmpty()
+                    }
+                }
+            }
+        } catch (_: Exception) { }
+        return ""
+    }
