+    private fun pairCurrentLgTv() {
+        val device = DeviceStore.find(this, currentDeviceId) ?: run {
+            Toast.makeText(this, "Save/select a device first", Toast.LENGTH_SHORT).show()
+            return
+        }
+        if (device.host.isBlank()) {
+            Toast.makeText(this, "This device needs an IP / host first", Toast.LENGTH_LONG).show()
+            return
+        }
+        tvStatusText.text = "Connecting to ${device.displayName}…"
+        LgWebOsController.pair(this, device) { result ->
+            runOnUiThread {
+                tvStatusText.text = result.detail
+                result.updatedDevice?.let { refreshDevices(it.id) }
+                if (result.stage == LgWebOsController.Stage.PROMPT ||
+                    result.stage == LgWebOsController.Stage.PAIRED ||
+                    result.stage == LgWebOsController.Stage.MAC_LEARNED ||
+                    result.stage == LgWebOsController.Stage.ERROR) {
+                    Toast.makeText(this, result.detail, Toast.LENGTH_LONG).show()
+                }
+            }
+        }
+    }
+
+    private fun testCurrentLgPowerOff() {
+        val device = DeviceStore.find(this, currentDeviceId) ?: run {
+            Toast.makeText(this, "Save/select a device first", Toast.LENGTH_SHORT).show()
+            return
+        }
+        tvStatusText.text = "Testing LG power off…"
+        LgWebOsController.powerOff(this, device) { result ->
+            runOnUiThread {
+                tvStatusText.text = result.detail
+                result.updatedDevice?.let { refreshDevices(it.id) }
+                Toast.makeText(this, result.detail, Toast.LENGTH_LONG).show()
+            }
+        }
+    }
+
+    private fun forgetCurrentLgPairing() {
+        val device = DeviceStore.find(this, currentDeviceId) ?: run {
+            Toast.makeText(this, "Save/select a device first", Toast.LENGTH_SHORT).show()
+            return
+        }
+        val updated = LgWebOsController.forgetPairing(this, device)
+        refreshDevices(updated.id)
+        tvStatusText.text = "${updated.displayName}: LG pairing key removed"
+        Toast.makeText(this, "LG pairing forgotten", Toast.LENGTH_SHORT).show()
+    }
+
     private fun currentTrigger(): RemoteCommand {
