<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wedding PA"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Phone-only PA • LE sharing • Wi-Fi dual-phone speaker sync"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISARMED"
                android:textColor="@color/amber"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Choose your microphone and speaker, then arm the PA."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/levelMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <Button
            android:id="@+id/talkButton"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_talk_idle"
            android:text="HOLD TO TALK"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="31sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/latchSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tap-to-talk latch mode"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/armButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="ARM PA"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Microphone input"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/inputSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Speaker output"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/outputSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Refresh devices"
                    android:textAllCaps="false" />

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <Button
                    android:id="@+id/bluetoothButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Bluetooth settings"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output &amp; sync"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/multiOutputSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/leCapabilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LE Audio capability: checking…"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/routeSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Routed outputs: not available until PA is armed"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/syncTestButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:enabled="false"
                android:text="Send 3-pulse speaker sync test"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Dual — classic Bluetooth workaround"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/networkInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Choose MASTER or SATELLITE above."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/satelliteIpEdit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:hint="Satellite LAN IP, e.g. 192.168.1.42"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <Button
                android:id="@+id/discoverSatelliteButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Discover WeddingPA satellite"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/localDelayLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Master local speaker delay: 100 ms"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/localDelaySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="500"
                android:progress="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Increase this if the master speaker fires before the satellite. Run the 3-pulse test and adjust until the two clicks merge."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/satelliteBufferLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Satellite jitter buffer: 100 ms"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/satelliteBufferSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="460"
                android:progress="60" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="40–500 ms. 100 ms is the starting point for a normal local Wi-Fi network. Increase it only if the satellite crackles from packet jitter."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guaranteed dual-phone music player"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No internal playlist selected."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Why local files? Android may block capturing Spotify/other protected apps. WeddingPA can synchronize music + microphone perfectly only when it owns the music PCM itself."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chooseMusicButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Choose local music / playlist"
                android:textAllCaps="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playMusicButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Play"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/pauseMusicButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Pause"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/nextMusicButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Next"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/stopMusicButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Stop"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/musicVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Internal music volume: 100%"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/musicVolumeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="125"
                android:progress="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <Switch
                android:id="@+id/duckSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Automatically duck music while talking"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/highPassSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginTop="8dp"
                android:text="80 Hz rumble / handling-noise filter"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gainLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mic gain: 1.00×"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/gainSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="250"
                android:progress="50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="A soft limiter is always active to catch sudden shouting/clipping. Internal music ducks to about 28% while TALK is active."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wedding reliability"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="• Put both phones on the same local Wi-Fi for Wi-Fi Dual\n• Connect MASTER phone to speaker #1 and SATELLITE phone to speaker #2\n• Start SATELLITE first, then discover it from MASTER\n• Use local music files for guaranteed two-speaker music + mic synchronization\n• Run the pulse test and trim master delay before guests arrive\n• Use Do Not Disturb and test the exact lav + speakers for at least 30 minutes"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/appSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Open app battery / permission settings"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingBottom="24dp"
            android:text="v0.3.0 • Wi-Fi dual-phone classic-Bluetooth workaround • internal local-file PCM player • adjustable sync buffer/delay • LE Audio mode retained."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
