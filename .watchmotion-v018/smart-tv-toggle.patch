+    fun smartToggle(context: Context, device: DeviceProfile, callback: (Result) -> Unit) {
+        val appContext = context.applicationContext
+        val host = device.host.trim()
+        val key = device.webOsClientKey.trim()
+
+        if (host.isBlank() || key.isBlank()) {
+            wakeForToggle(appContext, device, callback)
+            return
+        }
+
+        callback(Result(true, Stage.CONNECTING, "${device.displayName}: checking TV power state…", device))
+        Thread({
+            val reachable = webOsEndpointReachable(host)
+            android.os.Handler(appContext.mainLooper).post {
+                if (reachable) {
+                    powerOff(appContext, device, callback)
+                } else {
+                    wakeForToggle(appContext, device, callback)
+                }
+            }
+        }, "WatchMotion-LgToggleProbe").start()
+    }
+
+    private fun wakeForToggle(context: Context, device: DeviceProfile, callback: (Result) -> Unit) {
+        LgTvController.wake(context, device) { wake ->
+            callback(
+                Result(
+                    ok = wake.ok,
+                    stage = if (wake.ok) Stage.WAKE_SENT else Stage.ERROR,
+                    detail = if (wake.ok) "${device.displayName}: TV offline → wake sent ✓" else wake.detail,
+                    updatedDevice = device
+                )
+            )
+        }
+    }
+
+    private fun webOsEndpointReachable(host: String): Boolean {
+        for (port in intArrayOf(3001, 3000)) {
+            try {
+                Socket().use { socket ->
+                    socket.connect(InetSocketAddress(host, port), 425)
+                    return true
+                }
+            } catch (_: Exception) { }
+        }
+        return false
+    }
